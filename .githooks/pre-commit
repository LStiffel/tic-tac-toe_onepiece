#!/bin/sh
FAIL=0

for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '^\.claude/skills/.*/SKILL\.md$'); do
  dir=$(dirname "$f")
  folder_name=$(basename "$dir")

  if [ ! -f "$f" ]; then
    continue
  fi

  if ! head -1 "$f" | grep -q '^---$'; then
    echo "BLOCKED: $f is missing YAML frontmatter (must start with ---)"
    FAIL=1
    continue
  fi

  name_line=$(sed -n '2,/^---$/p' "$f" | grep '^name:')
  desc_line=$(sed -n '2,/^---$/p' "$f" | grep '^description:')

  if [ -z "$name_line" ]; then
    echo "BLOCKED: $f is missing the 'name:' field"
    FAIL=1
  fi

  if [ -z "$desc_line" ]; then
    echo "BLOCKED: $f is missing the 'description:' field"
    FAIL=1
  fi

  name_value=$(echo "$name_line" | sed "s/^name:[[:space:]]*//" | tr -d '"'"'"'')
  if [ -n "$name_value" ] && [ "$name_value" != "$folder_name" ]; then
    echo "BLOCKED: $f has name '$name_value' but folder is '$folder_name'"
    FAIL=1
  fi
done

if [ "$FAIL" -eq 1 ]; then
  echo ""
  echo "Commit rejected: fix SKILL.md issues above."
  exit 1
fi

exit 0